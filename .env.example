# Copy to .env or .env.local at the repo root — never commit secrets.

OPENAI_API_KEY=sk-...

# Model (optional). Supported: OPENAI_MODEL or OPENAI_MODEL_ID
OPENAI_MODEL=gpt-4o-mini

# Organization (optional). Supported: OPENAI_ORGANIZATION or OPENAI_ORG_ID
# OPENAI_ORGANIZATION=org-...

# Optional override for plan JSON storage (default: <repo>/data/plans)
# PLANS_DIR=
